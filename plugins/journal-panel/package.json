{
  "name": "@local/journal-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "账本可视化面板：今天/待办/项目/本子/想法/活动六大视图，项目可增删、条目可勾选、支持热重载。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaobrad639-cpu/jiwei.git"
  },
  "homepage": "https://github.com/shaobrad639-cpu/jiwei#readme"
}
